{
  "name": "cmake-presets-editor",
  "displayName": "CMake Presets Editor",
  "description": "在 VS Code 里用表单编辑 CMakePresets.json：变量补全、继承生效值、引用校验",
  "version": "0.1.4",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lirwei/cmake_preset_setting.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cmake",
    "presets",
    "cmake-presets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:cmakePresets.editor"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "cmakePresets.editor",
        "displayName": "CMake Presets 编辑器",
        "selector": [
          {
            "filenamePattern": "**/CMakePresets.json"
          },
          {
            "filenamePattern": "**/CMakeUserPresets.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "cmakePresets.openEditor",
        "title": "CMake Presets: 用可视化编辑器打开",
        "icon": {
          "light": "media/icons/open-editor-light.svg",
          "dark": "media/icons/open-editor-dark.svg"
        }
      },
      {
        "command": "cmakePresets.createFile",
        "title": "CMake Presets: 新建 CMakePresets.json"
      },
      {
        "command": "cmakePresets.installCatalog",
        "title": "CMake Presets: 查看变量目录状态"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cmakePresets.openEditor",
          "when": "resourceFilename == CMakePresets.json || resourceFilename == CMakeUserPresets.json",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "cmakePresets.openEditor",
          "when": "resourceFilename == CMakePresets.json || resourceFilename == CMakeUserPresets.json",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "node node_modules/typescript/bin/tsc -p .",
    "package": "node esbuild.mjs && node -e \"require('fs').mkdirSync('build',{recursive:true})\" && vsce package --no-dependencies --out build/cmake-presets-editor.vsix",
    "test": "node node_modules/typescript/bin/tsc -p . && node --test test/*.test.mjs"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.7.2"
  }
}
